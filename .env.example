# Optional owned HTTPS /app URL; no query strings, fragments, or credentials.
# Leave unset for the explicitly labeled https://example.com/app demo link.
# EXPO_PUBLIC_SAVLY_APP_LINK=https://your-owned-domain.example/app

# API base URL (no /v1 suffix). Development defaults to this hosted server.
# Override in .env.local, then restart Expo with --clear. Also supported in release builds.
# EXPO_PUBLIC_FX_API_URL=https://a2ckcxro8g.execute-api.us-east-1.amazonaws.com

# Cognito: local/development uses the owner's public pool and app-client IDs.
# Release builds require an explicit authority and client ID. Never add a client secret.
# EXPO_PUBLIC_APP_ENV=development
# EXPO_PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_MncSdF1r0
# EXPO_PUBLIC_COGNITO_CLIENT_ID=35vicii2qq71r09bcd0val80lm
# Optional legacy managed-login domain, retained to renew previously saved browser sessions.
# New in-app sign-in uses SRP and needs no managed-login domain or redirect URI.
# EXPO_PUBLIC_COGNITO_DOMAIN=https://savly.auth.us-east-1.amazoncognito.com
