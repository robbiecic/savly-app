{
  "name": "savly-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "decimal.js": "^10.6.0",
    "expo": "~57.0.26",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "jimp-compact": "^0.16.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:dependencies": "expo install --check",
    "export:mobile": "expo export --platform android --platform ios",
    "test": "node --import tsx --test tests/*.test.ts",
    "web": "expo start --web",
    "test:ui": "playwright test",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:icons": "node scripts/export-icons.cjs"
  },
  "private": true
}
