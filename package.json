{
  "name": "savly-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "decimal.js": "^10.6.0",
    "expo": "~57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.12.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "jimp-compact": "^0.16.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.cjs",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:dependencies": "expo install --check",
    "export:mobile": "expo export --platform android --platform ios",
    "test": "node --import tsx --test tests/*.test.ts",
    "web": "expo start --web",
    "test:ui": "playwright test",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:icons": "node scripts/export-icons.cjs",
    "test:auth:ui": "playwright test --config playwright.auth.config.ts",
    "start:dev": "expo start --dev-client --clear",
    "check:build": "npm run typecheck && npm test",
    "preandroid": "npm run check:build",
    "preios": "npm run check:build",
    "preexport:mobile": "npm run check:build",
    "preexport:web": "npm run check:build"
  },
  "private": true
}
